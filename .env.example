# ============================================================
# Power Platform – Error Handling Template
# Environment Variables
# ============================================================
# Copy this file to .env and fill in values for each environment.
# Never commit .env to source control.

# ── Target Environment ───────────────────────────────────────
# The GUID from the Power Platform environment URL
# e.g. https://make.powerapps.com/environments/<ENVIRONMENT_ID>/home
ENVIRONMENT_ID=YOUR-ENVIRONMENT-ID-HERE

# The Dataverse org URL for this environment
ENVIRONMENT_URL=YOUR-ENVIRONMENT-URL-HERE

# Human-readable label used in pac auth commands
ENVIRONMENT_NAME=NAME-OF-YOUR-ENVIRONMENT-HERE

# ── Solution ─────────────────────────────────────────────────
SOLUTION_UNIQUE_NAME=ErrorHandling
SOLUTION_DISPLAY_NAME=Error Handling
SOLUTION_VERSION=1.0.4.0

# Publisher (must exist in target environment)
PUBLISHER_UNIQUE_NAME=PUBLISHER_UNIQUE_NAME_HERE
PUBLISHER_PREFIX=PUBLISHER_PREFIX_HERE

# ── Teams Notification ───────────────────────────────────────
# Replace these after you've wired up the Microsoft Teams connector
# in the Error Handling Template flow's Finally scope.
#
# Find Group ID:  Teams > ... > Get link to team > copy the groupId param
# Find Channel ID: Teams > channel > ... > Get link to channel > copy the channelId param
TEAMS_GROUP_ID=your-teams-group-id-here
TEAMS_CHANNEL_ID=your-teams-channel-id-here

# ── Email Notification (alternative to Teams) ─────────────────
# Used if you swap the Teams action for Send an Email
NOTIFICATION_EMAIL=RECIPIENT-EMAIL-HERE

# ── Power Automate Link Base ──────────────────────────────────
# Used in the FlowLink expression inside the flow itself.
# This is auto-resolved by workflow().tags.environmentName — no action needed.
# Documented here for reference only.
# FLOW_LINK_BASE=https://make.powerautomate.com/environments/${ENVIRONMENT_ID}/flows/

# ── Flow GUIDs (stable across environments once imported) ────────
# These GUIDs are embedded in the solution package. Use them to
# identify flows without duplicating them on re-import.
FLOW_GUID_ERROR_HANDLING_TEMPLATE=3fc9a2b1-d4e5-4678-9012-3456789abcde
FLOW_GUID_GET_ERROR_MESSAGE=5ae8b3c2-f6d7-4891-b023-456789abcdef
FLOW_GUID_SEND_NOTIFICATION=7cd4e5f6-a8b9-4c2d-b1e3-567890abcdef

# ── pac CLI Auth ──────────────────────────────────────────────
# Run this to authenticate before deploying to a new environment:
#   pac auth create --deviceCode --environment ${ENVIRONMENT_ID}
# Run this to import the solution (first time):
#   pac solution import --path ErrorHandling_v2.zip --activate-plugins
# Run this to upgrade an existing solution (subsequent times):
#   pac solution import --path ErrorHandling_v2.zip --activate-plugins --force-overwrite
